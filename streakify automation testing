@Test
public void TC_018_verifyBrowserBackButton() {

    // Step 1: Complete onboarding
    driver.findElement(By.name("userName"))
          .sendKeys("Kaviya");

    driver.findElement(By.xpath("//input[@placeholder='Your current age']"))
          .sendKeys("22");

    driver.findElement(By.xpath("//button[contains(text(),'Next')]"))
          .click();

    driver.findElement(By.xpath("//input[@placeholder='Your current designation']"))
          .sendKeys("Software Tester");

    driver.findElement(By.xpath("//input[@placeholder='Your goal']"))
          .sendKeys("Learn Selenium Automation");

    driver.findElement(By.xpath("//button[@type='submit']"))
          .click();

    // Step 2: Wait for application page
    wait.until(ExpectedConditions.urlContains(
        "streakify-consistency-tracker.vercel.app"
    ));

    // Step 3: Store Home page URL
    String homeUrl = driver.getCurrentUrl();

    // Step 4: Open Task page
    driver.findElement(By.xpath("//a[normalize-space()='Task']"))
          .click();

    // Step 5: Wait until navigation occurs
    wait.until(driver ->
        !driver.getCurrentUrl().equals(homeUrl)
    );

    String taskUrl = driver.getCurrentUrl();

    Assert.assertNotEquals(
        taskUrl, homeUrl,
        "Task page navigation did not occur"
    );

    // Step 6: Click browser Back button
    driver.navigate().back();

    // Step 7: Wait until Home page URL returns
    wait.until(ExpectedConditions.urlToBe(homeUrl));

    // Step 8: Verify browser Back navigation
    Assert.assertEquals(
        driver.getCurrentUrl(),
        homeUrl,
        "Browser Back button did not return to the previous page"
    );

    System.out.println(
        "TC_018 Passed: Browser Back button returned to previous page"
    );
}


