@Test
public void TC_010_verifyMultipleTasksCreation() {

    // Step 1: Complete onboarding
    driver.findElement(By.cssSelector("input[name='userName']"))
          .sendKeys("Kaviya");

    driver.findElement(By.xpath("//input[@placeholder='Your current age']"))
          .sendKeys("22");

    driver.findElement(By.xpath("//button[contains(text(),'Next')]"))
          .click();

    driver.findElement(By.xpath("//input[@placeholder='Your current designation']"))
          .sendKeys("Software Tester");

    driver.findElement(By.xpath("//input[@placeholder='Your goal']"))
          .sendKeys("Learn Selenium Automation");

    driver.findElement(By.xpath("//button[@type='submit']"))
          .click();

    // Step 2: Open Task page
    driver.findElement(By.xpath("//a[normalize-space()='Task']"))
          .click();

    // Step 3: Create multiple tasks
    String[] tasks = {
        "Learn Selenium",
        "Practice Java",
        "Read Book"
    };

    for (String taskName : tasks) {

        driver.findElement(
            By.cssSelector("button.bg-white.text-gray-900")
        ).click();

        driver.findElement(By.cssSelector("input[name='start']"))
              .sendKeys("07:00");

        driver.findElement(By.cssSelector("input[name='end']"))
              .sendKeys("08:00");

        // Enter the current task name
        driver.findElement(By.cssSelector("input[name='do']"))
              .sendKeys(taskName);

        driver.findElement(
            By.xpath("//button[normalize-space()='Add Task']")
        ).click();

        // Verify alert
        Alert alert = wait.until(
            org.openqa.selenium.support.ui.ExpectedConditions
                .alertIsPresent()
        );

        Assert.assertEquals(
            alert.getText(),
            "Task Added",
            "Task addition failed: " + taskName
        );

        alert.accept();
    }

    // Step 4: Verify all tasks are displayed
    for (String taskName : tasks) {

        WebElement task = wait.until(
            org.openqa.selenium.support.ui.ExpectedConditions
                .visibilityOfElementLocated(
                    By.xpath("//*[normalize-space()='" + taskName + "']")
                )
        );

        Assert.assertTrue(
            task.isDisplayed(),
            "Task not displayed: " + taskName
        );
    }

    System.out.println(
        "TC_010 Passed: All three tasks were added and displayed."
    );
}

